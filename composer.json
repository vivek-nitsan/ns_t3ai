{
    "name": "nitsan/ns-t3ai",
    "type": "typo3-cms-extension",
    "version": "15.0.0",
    "description": "T3AI Free \u2013 SEO page-title suggestions and RTE AI powered by AI Foundation (ns_t3af).",
    "homepage": "https://t3planet.com/t3ai-typo3-extension",
    "authors": [
        {
            "name": "Team T3Planet",
            "role": "Developer",
            "homepage": "https://t3planet.com",
            "email": "support@t3planet.com"
        }
    ],
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "T3AI",
        "AI",
        "SEO",
        "RTE",
        "AI Foundation"
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-rte-ckeditor": "^13.4 || ^14.3",
        "nitsan/ns-t3af": "^2.0",
        "nitsan/ns-license": ">=14.5.0"
    },
    "autoload": {
        "psr-4": {
            "NITSAN\\NsT3Ai\\": "Classes"
        }
    },
    "replace": {
        "typo3-ter/ns-t3ai": "self.version"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ns_t3ai"
        }
    }
}
